# Copy to .env.local and fill in. NEVER commit real values (.env* is gitignored).

# Supabase — a SECRET key (sb_secret_…, the new API key system; bypasses RLS,
# server-only, never exposed to the browser). Create a dedicated one in the
# dashboard: Project Settings → API → Secret keys → New secret key.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Password-per-role gate. Each role has its own login password:
#   ADMIN_PASSWORD   → "admin"   (Pablo / business: everything except Técnico)
#   MARIANA_PASSWORD → "mariana" (Mariana: same tier as admin, own password)
#   DEV_PASSWORD     → "dev"     (técnico superuser: the above + technical screens)
# SESSION_SECRET signs the role into the cookie (generate: openssl rand -hex 32).
ADMIN_PASSWORD=change-me
MARIANA_PASSWORD=change-me-as-well
DEV_PASSWORD=change-me-too
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Cloudflare R2 (for the Técnico → Almacenamiento screen; lists objects to total
# storage per broker). Create a read+list API token in Cloudflare → R2 → Manage
# API Tokens. Server-only.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=propia-photos

# Google Maps for the Zonas map (Técnico → Zonas). A BROWSER key — separate
# from the app's Places key (that one lives server-side in the places-proxy
# Edge Function and must never ship to a client). In the GCP console: enable
# "Maps JavaScript API", create an API key restricted by HTTP referrer to
# admin.propia.dev and localhost:3000, and put it here. NEXT_PUBLIC_* bakes in
# at BUILD time, so after changing it: rebuild/redeploy, no Lambda env change.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIza...
